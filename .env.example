# The secrets of albireo. Copy this file and fill in the values in the copy.
# Git ignores every .env file except this one, so never write values here.
#
# For `cf dev` with an "s3" development storage, copy this file to .env and fill in
# keys for the development bucket. The "local-r2" development storage needs no keys.
# For `cf deploy`, write keys for the production bucket in a file that Git ignores,
# such as .env.production, and pass it with `cf deploy --secrets-file .env.production`.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
