# The secrets that compose.yaml passes to albireo and PostgreSQL. Copy this file to .env and
# write the values there. Git ignores .env, so never write the values here.

# The password of the database. It goes into DATABASE_URL, so use letters and digits only,
# such as the output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The access key of the bucket. Make it in the console of your storage service, with
# permission to read, write, and delete the objects of the bucket of compose.yaml, and of
# no other bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
