# The access key of the bucket, which compose.yaml passes to albireo. Copy this file to .env
# and write the values there. Git ignores .env, so never write the values here.
#
# Make the key in the console of your storage service, with permission to read, write, and
# delete the objects of the bucket of compose.yaml, and of no other bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
